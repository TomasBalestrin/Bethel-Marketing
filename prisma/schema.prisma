generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MENTORADO
}

enum SiteStatus {
  DRAFT
  GENERATING
  PREVIEW
  PUBLISHED
  ERROR
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(MENTORADO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites            Site[]
  contentProfiles  ContentProfile[]
  contentPieces    ContentPiece[]
  contentPlans     ContentPlan[]
  googleConnection GoogleConnection?
  gbpLocations     GbpLocation[]

  @@map("users")
}

// ── Google Business Profile (Google Meu Negócio) ──────────────────────────────

model GoogleConnection {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccountId String?
  accessToken     String?   @db.Text // criptografado
  refreshToken    String?   @db.Text // criptografado
  tokenExpiry     DateTime?
  scopes          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("google_connections")
}

model GbpLocation {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountName     String? // resource name da conta GBP
  locationName    String // resource name do local GBP
  title           String?
  primaryCategory String?
  placeId         String?
  address         String?
  phone           String?
  website         String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())

  snapshots       GbpLocationSnapshot[]
  metrics         GbpMetric[]
  reviews         GbpReview[]
  posts           GbpPost[]
  recommendations GbpRecommendation[]
  competitors     GbpCompetitor[]

  @@index([userId])
  @@map("gbp_locations")
}

model GbpLocationSnapshot {
  id         String      @id @default(uuid())
  locationId String
  location   GbpLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  capturedAt DateTime    @default(now())
  rawJson    Json

  @@index([locationId])
  @@map("gbp_location_snapshots")
}

model GbpMetric {
  id         String      @id @default(uuid())
  locationId String
  location   GbpLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  month      String // "2026-06"
  metricType String // impressions_search, impressions_maps, website_clicks, calls, direction_requests...
  value      Int
  capturedAt DateTime    @default(now())

  @@unique([locationId, month, metricType])
  @@index([locationId])
  @@map("gbp_metrics")
}

model GbpReview {
  id           String      @id @default(uuid())
  locationId   String
  location     GbpLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  gbpReviewId  String
  reviewerName String?
  starRating   Int?
  comment      String?     @db.Text
  replyText    String?     @db.Text
  replied      Boolean     @default(false)
  createTime   DateTime?
  updateTime   DateTime?

  @@unique([locationId, gbpReviewId])
  @@index([locationId])
  @@map("gbp_reviews")
}

model GbpPost {
  id           String      @id @default(uuid())
  locationId   String
  location     GbpLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  gbpPostId    String?
  summary      String?     @db.Text
  postType     String? // standard | event | offer
  state        String? // draft | scheduled | published
  scheduledFor DateTime?
  publishedAt  DateTime?
  mediaUrl     String?
  createdAt    DateTime    @default(now())

  @@index([locationId])
  @@map("gbp_posts")
}

model GbpRecommendation {
  id          String      @id @default(uuid())
  locationId  String
  location    GbpLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  generatedAt DateTime    @default(now())
  category    String?
  priority    String? // alta | media | baixa
  title       String
  description String?     @db.Text
  status      String      @default("open") // open | done | dismissed

  @@index([locationId])
  @@map("gbp_recommendations")
}

model GbpCompetitor {
  id         String                  @id @default(uuid())
  locationId String
  location   GbpLocation             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  placeId    String?
  name       String
  category   String?
  address    String?
  createdAt  DateTime                @default(now())
  snapshots  GbpCompetitorSnapshot[]

  @@index([locationId])
  @@map("gbp_competitors")
}

model GbpCompetitorSnapshot {
  id           String        @id @default(uuid())
  competitorId String
  competitor   GbpCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  capturedAt   DateTime      @default(now())
  rating       Float?
  reviewCount  Int?
  photoCount   Int?
  hasWebsite   Boolean?
  hoursJson    Json?

  @@index([competitorId])
  @@map("gbp_competitor_snapshots")
}

model ContentPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileId  String? // qual perfil/Instagram gerou este plano
  instagram  String? // @ do perfil (snapshot para exibição no histórico)
  titulo     String  @default("Plano de conteúdo")
  quantidade Int
  // Array de itens do calendário; cada item pode conter o roteiro completo (gerado sob demanda)
  itens      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("content_plans")
}

model ContentProfile {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  instagram      String? // @ do perfil (identifica cada Instagram do mentorado)
  negocio        String
  nicho          String
  publico        String  @db.Text // quem é o cliente ideal
  idadePublico   String? // faixa etária
  essencia       String? @db.Text // essência/diferencial do profissional
  transformacao  String? @db.Text // antes → depois que o negócio entrega
  tomVoz         String? // próximo, técnico, provocador...
  crencas        String? @db.Text // opiniões/crenças fortes do mentorado
  objecoes       String? @db.Text // objeções comuns dos clientes
  provas         String? @db.Text // casos, números, depoimentos
  servicos       String? @db.Text // serviços/produtos/procedimentos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("content_profiles")
}

model ContentPiece {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  funil     String // topo | meio | fundo
  categoria String // conexao | educacional | viral | venda
  formato   String // reels | carrossel | imagem
  tema      String @db.Text
  servico   String?

  titulo   String
  conteudo Json // roteiro estruturado (gancho, estrutura, legenda, cta, hashtags...)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("content_pieces")
}

model Site {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identidade
  nomeNegocio String
  segmento    String
  cidade      String
  estado      String
  endereco    String
  cep         String
  corPaleta   String
  logoUrl     String?

  // Serviços
  servicos         Servico[]
  servicoDestaque  String
  resultadoCliente String

  // Público
  dorPrincipal String

  // Hero
  heroFotoUrl String?
  headline    String?
  subheadline String?
  ctaTexto    String?

  // Credibilidade
  anosNoMercado       Int
  totalClientes       Int?
  totalClientesLabel  String?
  certificados        String?
  depoimentos    Depoimento[]

  // Fotos
  foto1Url            String?
  foto2Url            String?
  foto3Url            String?
  fotoProfissionalUrl String?

  // Contato
  whatsapp              String
  whatsappMensagem      String
  instagram             String?
  horarioAtendimento    String
  registros             RegistroProfissional[]

  // Rastreamento
  metaPixelId    String?
  metaPixelToken String?
  gtmId          String?

  // Site gerado
  slug            String?    @unique
  subdomain       String?    @unique
  htmlGerado      String?    @db.Text
  vercelProjectId String?
  vercelUrl       String?
  status          SiteStatus @default(DRAFT)
  geracoesCount   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sites")
}

// Briefing enviado pelo mentorado (formulário público) para eu criar o site
model Briefing {
  id                String   @id @default(uuid())
  nomeEmpresa       String
  email             String?
  whatsapp          String
  endereco          String?
  instagram         String?
  horario           String?
  servicos          String?  @db.Text
  servicoCarroChefe String?
  anosMercado       String?
  clientesAtendidos String?
  logoUrl           String?
  fotosEmpresa      String[]
  fotosDepoimento   String[]
  fotosAntesDepois  String[]
  observacoes       String?  @db.Text
  status            String   @default("novo") // novo | em_andamento | concluido
  createdAt         DateTime @default(now())

  @@map("briefings")
}

model Servico {
  id        String  @id @default(uuid())
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  imagemUrl String?
  ordem     Int     @default(0)

  @@map("servicos")
}

model Depoimento {
  id        String @id @default(uuid())
  siteId    String
  site      Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  imagemUrl String

  @@map("depoimentos")
}

model RegistroProfissional {
  id     String @id @default(uuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tipo   String
  numero String

  @@map("registros_profissionais")
}
